{$DOMAIN}, www.{$DOMAIN} {
	# Cloudflare Origin Certificate (SSL mode "Full (strict)"); see DEPLOY.md
	tls /certs/origin.pem /certs/origin.key
	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	encode zstd gzip
	request_body {
		max_size 9MB
	}
	header {
		-Server
		-X-Powered-By
	}
	# Model weights and WASM are immutable per version
	@immutable path /models/* /ort/* /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:3000 {
		header_up X-Real-IP {client_ip}
	}
	log {
		output stdout
		format json
	}
}
