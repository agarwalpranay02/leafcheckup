# Build from the repo root so the model can be taken straight from the web app.
FROM python:3.12-slim AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY services/inference/requirements.txt /w/requirements.txt
RUN pip install --prefix=/install -r /w/requirements.txt

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MODEL_DIR=/models ORT_THREADS=2
RUN groupadd -r app && useradd -r -g app -u 10001 app
COPY --from=build /install /usr/local
WORKDIR /srv
COPY services/inference/app ./app
COPY apps/web/public/models/effb0-2026.11 /models
USER 10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/healthz' % __import__('os').environ.get('PORT','8000'),timeout=2).status==200 else 1)"
# PORT and WEB_CONCURRENCY let hosts such as Render (512 MB free tier: 1 worker) size the service
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-2} --no-server-header"]
