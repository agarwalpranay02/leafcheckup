# ---- Public ----
NEXT_PUBLIC_SITE_URL=https://leafcheckup.com
NEXT_PUBLIC_CONTACT_EMAIL=leafcheckup@gmail.com

# ---- Database (Postgres). Leave unset locally to use embedded PGlite in .data/ ----
DATABASE_URL=postgres://leafcheckup:CHANGE_ME@db:5432/leafcheckup
AUTO_MIGRATE=1

# ---- Auth (better-auth) ----
BETTER_AUTH_URL=https://leafcheckup.com
BETTER_AUTH_SECRET=            # openssl rand -hex 32
GOOGLE_CLIENT_ID=              # optional: Google sign-in
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=                # email sign-in links + contact notifications
EMAIL_FROM="LeafCheckup <onboarding@resend.dev>"
CONTACT_INBOX=you@example.com

# ---- API ----
API_KEY_PEPPER=                # openssl rand -hex 24 (never change after launch: invalidates keys)
INFERENCE_URL=http://inference:8000
INFERENCE_TOKEN=               # openssl rand -hex 24, same value in the inference service


# ---- Optional: shared rate limits across instances ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only ----
ALLOW_DEV_LOGIN=0
TRUST_PROXY=1

# ---- Optional: OpenTelemetry tracing ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
